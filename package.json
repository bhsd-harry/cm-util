{
	"name": "@bhsd/cm-util",
	"version": "2.4.2",
	"homepage": "https://github.com/bhsd-harry/cm-util#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/cm-util/issues"
	},
	"license": "MIT",
	"author": "Bhsd",
	"files": [
		"/dist/"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"prepublishOnly": "npm run build",
		"build": "tsc && esbuild src/cm.ts --charset=utf8 --target=es2019 --format=esm --outfile=dist/cm.js && eslint --no-config-lookup -c eslint.dist.js dist/*.js",
		"lint:ts": "tsc --noEmit && oxlint && eslint --cache .",
		"lint": "npm run lint:ts",
		"migrate": "oxlint-migrate",
		"test": "echo 'This package has no tests.'"
	},
	"peerDependencies": {
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"monaco-editor": ">=0.11.0"
	},
	"peerDependenciesMeta": {
		"@codemirror/state": {
			"optional": true
		},
		"@codemirror/view": {
			"optional": true
		},
		"monaco-editor": {
			"optional": true
		}
	},
	"devDependencies": {
		"@bhsd/code-standard": "^5.1.0",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@oxlint/migrate": "^1.89.0",
		"eslint": "^10.14.0",
		"monaco-editor": "^0.57.0",
		"oxlint": "^1.89.0",
		"typescript": "^6.0.3",
		"wikiparser-node": "^1.48.1"
	},
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	}
}
